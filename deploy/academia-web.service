[Unit]
Description=academia-web UI
After=network-online.target
Wants=network-online.target

[Service]
User=academia
Group=academia
WorkingDirectory=/opt/academia-web
ExecStart=/usr/local/bin/academia-web --bind 127.0.0.1 --port 3000 --dir /opt/academia-web/downloads
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/academia-web

[Install]
WantedBy=multi-user.target
